# Supabase project settings — Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-side only, never expose to the browser. Used by the seed
# script and any server route that needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
